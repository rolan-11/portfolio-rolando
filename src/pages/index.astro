---
// Portfolio Universitario - Rolando Capuma
// Cumple todos los requisitos técnicos y opcionales del TP.
---

<html lang="es" style="scroll-behavior: smooth;">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Portfolio - Rolando Capuma</title>
    <meta name="description" content="Portfolio de Rolando Capuma, Desarrollador de Software y Estudiante de Ingeniería en Sistemas.">
    
    <style>
      /* Variables CSS (Modo Claro por defecto) */
      :root {
        --primario: #0056b3;
        --fondo: #f8f9fa;
        --texto: #333333;
        --texto-claro: #555555;
        --tarjeta: #ffffff;
        --borde: #eaeaea;
        --btn-hover: #004494;
      }
      
      /* Variables CSS (Modo Oscuro - Requisito Opcional) */
      body.tema-oscuro {
        --primario: #66b2ff;
        --fondo: #121212;
        --texto: #f0f0f0;
        --texto-claro: #b0b0b0;
        --tarjeta: #1e1e1e;
        --borde: #333333;
        --btn-hover: #3399ff;
      }
      
      * { box-sizing: border-box; margin: 0; padding: 0; }
      
      body {
        font-family: system-ui, -apple-system, sans-serif;
        background-color: var(--fondo);
        color: var(--texto);
        line-height: 1.6;
        transition: background-color 0.3s, color 0.3s;
      }

      /* Accesibilidad: Navegación por teclado */
      a:focus, button:focus, input:focus, textarea:focus {
        outline: 3px solid var(--primario);
        outline-offset: 2px;
      }

      .contenedor { max-width: 1000px; margin: 0 auto; padding: 0 20px; }

      /* Navegación */
      header {
        display: flex; justify-content: space-between; align-items: center;
        padding: 20px 0; flex-wrap: wrap; gap: 15px;
      }
      .logo { font-size: 1.5rem; font-weight: bold; color: var(--primario); }
      nav { display: flex; align-items: center; gap: 20px; flex-wrap: wrap; justify-content: center; }
      nav ul { display: flex; gap: 20px; list-style: none; }
      nav a { text-decoration: none; color: var(--texto); font-weight: 600; }
      nav a:hover { color: var(--primario); }
      
      .btn-tema {
        background: var(--tarjeta); border: 1px solid var(--borde); color: var(--texto);
        padding: 8px 12px; border-radius: 6px; cursor: pointer; font-weight: bold;
      }

      section { padding: 60px 0; border-bottom: 1px solid var(--borde); }
      h2 { font-size: 2rem; margin-bottom: 30px; color: var(--texto); }

      /* Hero */
      #inicio { display: flex; align-items: center; gap: 40px; border-bottom: none; padding: 80px 0; }
      .hero-texto { flex: 1; }
      h1 { font-size: 3rem; margin-bottom: 10px; line-height: 1.1; }
      h1 span { color: var(--primario); }
      .subtitulo { font-size: 1.4rem; color: var(--texto-claro); margin-bottom: 20px; }
      
      /* Accesibilidad en imagen: se usa role="img" y aria-label si es un emoji o CSS */
      .avatar {
        width: 220px; height: 220px; background-color: var(--tarjeta); border-radius: 50%;
        display: flex; align-items: center; justify-content: center; font-size: 5rem;
        border: 5px solid var(--borde); box-shadow: 0 4px 10px rgba(0,0,0,0.1); flex-shrink: 0;
      }

      .botones { display: flex; gap: 15px; margin-top: 25px; flex-wrap: wrap; }
      .btn {
        padding: 12px 24px; text-decoration: none; border-radius: 6px;
        font-weight: bold; border: 2px solid var(--primario); transition: background 0.3s, transform 0.1s;
        display: inline-flex; align-items: center; justify-content: center;
      }
      .btn-lleno { background: var(--primario); color: white; }
      .btn-lleno:hover { background: var(--btn-hover); border-color: var(--btn-hover); color: white; }
      .btn-borde { background: transparent; color: var(--primario); }
      .btn-borde:hover { background: var(--primario); color: white; }

      .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; }
      .grid-3 { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 30px; }

      .categoria-tech strong { display: block; margin-bottom: 8px; color: var(--primario); }
      .etiquetas { display: flex; gap: 10px; flex-wrap: wrap; margin-bottom: 15px; }
      .tag { background: var(--tarjeta); border: 1px solid var(--borde); color: var(--texto); padding: 5px 12px; border-radius: 20px; font-size: 0.85rem; font-weight: 600; }
      
      .tarjeta {
        background: var(--tarjeta); padding: 25px; border-radius: 10px;
        border: 1px solid var(--borde); display: flex; flex-direction: column;
      }
      .tarjeta h3 { margin-bottom: 10px; }
      .tarjeta p { color: var(--texto-claro); margin-bottom: 20px; flex-grow: 1; }
      .link-proyecto { color: var(--primario); font-weight: bold; text-decoration: none; }
      .link-proyecto:hover { text-decoration: underline; }

      form { display: flex; flex-direction: column; gap: 15px; background: var(--tarjeta); padding: 30px; border-radius: 10px; border: 1px solid var(--borde); }
      label { font-weight: bold; font-size: 0.9rem; }
      input, textarea { padding: 12px; border: 1px solid var(--borde); border-radius: 6px; background: var(--fondo); color: var(--texto); width: 100%; }
      button[type="submit"] { background: var(--primario); color: white; border: none; padding: 12px; border-radius: 6px; font-weight: bold; cursor: pointer; font-size: 1rem; }
      button[type="submit"]:hover { background: var(--btn-hover); }

      footer { text-align: center; padding: 30px 0; color: var(--texto-claro); margin-top: 40px; }

      /* Animaciones Sutiles (Requisito Opcional) */
      @media (prefers-reduced-motion: no-preference) {
        .animar { opacity: 0; transform: translateY(20px); animation: aparecer 0.6s ease-out forwards; }
        .retraso-1 { animation-delay: 0.2s; }
        .retraso-2 { animation-delay: 0.4s; }
        @keyframes aparecer { to { opacity: 1; transform: translateY(0); } }
      }

      /* Responsive (Requisito Técnico) */
      @media (max-width: 768px) {
        header { flex-direction: column; text-align: center; }
        #inicio { flex-direction: column-reverse; text-align: center; }
        .grid-2 { grid-template-columns: 1fr; }
        .botones { justify-content: center; }
        h1 { font-size: 2.2rem; }
      }
    </style>
  </head>
  <body>
    <div class="contenedor">
      
      <!-- 1. NAVEGACIÓN SEMÁNTICA Y ACCESIBLE -->
      <header>
        <div class="logo">&lt;Rolando /&gt;</div>
        <nav aria-label="Navegación principal">
          <ul>
            <li><a href="#inicio">Inicio</a></li>
            <li><a href="#sobre-mi">Sobre mí</a></li>
            <li><a href="#proyectos">Proyectos</a></li>
            <li><a href="#contacto">Contacto</a></li>
          </ul>
          <!-- Botón Modo Oscuro -->
          <button id="btn-tema" class="btn-tema" aria-label="Alternar modo oscuro">🌙 Oscuro</button>
        </nav>
      </header>

      <main>
        
        <!-- 2. SECCIÓN HERO (Único H1) -->
        <section id="inicio" class="animar">
          <div class="hero-texto">
            <h1>Hola, soy <span>Rolando Capuma</span></h1>
            <p class="subtitulo">Desarrollador de Software / Estudiante de Ingeniería en Sistemas</p>
            <p>Me apasiona el desarrollo backend, el diseño de bases de datos y la resolución de problemas lógicos. Actualmente construyendo soluciones escalables y aplicando mi perfil técnico en sistemas informáticos.</p>
            
            <div class="botones">
              <a href="#proyectos" class="btn btn-lleno">Ver proyectos</a>
              <a href="#contacto" class="btn btn-borde">Contactarme</a>
              <!-- Requisito Opcional: CV Descargable -->
              <a href="/cv.pdf" download="CV_Rolando_Capuma.pdf" class="btn btn-borde" aria-label="Descargar mi Currículum en PDF">📄 Descargar CV</a>
            </div>
          </div>
          <div class="avatar" role="img" aria-label="Avatar de Rolando Capuma">💻</div>
        </section>

        <!-- 3. SECCIÓN SOBRE MÍ -->
        <section id="sobre-mi" class="animar retraso-1">
          <h2>Sobre mí</h2>
          <div class="grid-2">
            <div>
              <p style="margin-bottom: 15px;">Soy estudiante de Ingeniería en Sistemas en UAI, con un fuerte enfoque en el diseño de arquitectura lógica y datos. Disfruto desarrollando desde el esquema relacional hasta el backend del servidor.</p>
              <p>También tengo experiencia en administración comercial, lo que me permite comprender los requerimientos del negocio y traducirlos en soluciones de software eficientes bajo metodologías ágiles.</p>
            </div>
            
            <div>
              <div class="categoria-tech">
                <strong>Backend & Base de Datos</strong>
                <div class="etiquetas">
                  <span class="tag">C# & ASP.NET Core</span>
                  <span class="tag">Python</span>
                  <span class="tag">SQL Server</span>
                </div>
              </div>
              <div class="categoria-tech">
                <strong>Frontend & Herramientas</strong>
                <div class="etiquetas">
                  <span class="tag">HTML / CSS</span>
                  <span class="tag">Git & GitHub</span>
                  <span class="tag">Scrum / Metodologías Ágiles</span>
                </div>
              </div>
            </div>
          </div>
        </section>

        <!-- 4. SECCIÓN PROYECTOS -->
        <section id="proyectos" class="animar retraso-2">
          <h2>Proyectos Destacados</h2>
          <div class="grid-3">
            
            <article class="tarjeta">
              <h3>Dashboard Académico</h3>
              <p>Aplicación web con arquitectura MVC. Visualización y gestión de datos mediante conexión directa a base de datos relacional.</p>
              <div class="etiquetas">
                <span class="tag">ASP.NET Core</span>
                <span class="tag">SQL Server</span>
              </div>
              <a href="https://github.com/rolan-11" target="_blank" rel="noopener noreferrer" class="link-proyecto" aria-label="Ver código de Dashboard Académico en GitHub">Ver repositorio →</a>
            </article>

            <article class="tarjeta">
              <h3>DB: Gestión de Eventos</h3>
              <p>Diseño de esquema relacional completo. Incluye creación de vistas SQL, restricciones y carga de datos de prueba estructurados.</p>
              <div class="etiquetas">
                <span class="tag">SQL Server</span>
                <span class="tag">Diseño de DB</span>
              </div>
              <a href="https://github.com/rolan-11" target="_blank" rel="noopener noreferrer" class="link-proyecto" aria-label="Ver código de Base de Datos Eventos en GitHub">Ver repositorio →</a>
            </article>

            <article class="tarjeta">
              <h3>Simulador POO</h3>
              <p>Script funcional enfocado en Programación Orientada a Objetos, con implementación de herencia, métodos y atributos de personajes.</p>
              <div class="etiquetas">
                <span class="tag">Python</span>
                <span class="tag">POO</span>
              </div>
              <a href="https://github.com/rolan-11" target="_blank" rel="noopener noreferrer" class="link-proyecto" aria-label="Ver código de Simulador POO en GitHub">Ver repositorio →</a>
            </article>

          </div>
        </section>

        <!-- 5. SECCIÓN CONTACTO -->
        <section id="contacto">
          <h2>Contacto</h2>
          <div class="grid-2">
            <div>
              <p style="margin-bottom: 20px;">Si te interesa mi perfil técnico o querés conversar sobre desarrollo de software, enviame un mensaje o conectemos en redes.</p>
              
              <ul style="list-style: none; display: flex; flex-direction: column; gap: 15px;">
                <li>📧 <a href="mailto:tu-email@ejemplo.com" class="link-proyecto" style="color: var(--texto);">tu-email@ejemplo.com</a></li>
                <li>🐙 <a href="https://github.com/rolan-11" target="_blank" rel="noopener noreferrer" class="link-proyecto" style="color: var(--texto);">github.com/rolan-11</a></li>
                <li>💼 <a href="https://linkedin.com/in/tu-perfil" target="_blank" rel="noopener noreferrer" class="link-proyecto" style="color: var(--texto);">LinkedIn</a></li>
              </ul>
            </div>

            <form id="form-contacto" aria-label="Formulario de contacto">
              <div>
                <label for="nombre">Nombre completo</label>
                <input type="text" id="nombre" name="nombre" required aria-required="true">
              </div>
              <div>
                <label for="email">Email</label>
                <input type="email" id="email" name="email" required aria-required="true">
              </div>
              <div>
                <label for="mensaje">Mensaje</label>
                <textarea id="mensaje" name="mensaje" rows="4" required aria-required="true"></textarea>
              </div>
              <button type="submit">Enviar mensaje</button>
            </form>
          </div>
        </section>

      </main>

      <footer>
        <p>© 2026 Rolando Capuma. Proyecto final de materia.</p>
      </footer>
    </div>

    <!-- Scripts de interactividad -->
    <script>
      // 1. Lógica del formulario
      const form = document.getElementById('form-contacto');
      if(form) {
        form.addEventListener('submit', (e) => {
          e.preventDefault();
          alert('¡Validación exitosa! Todos los campos están correctos.');
          form.reset();
        });
      }

      // 2. Lógica del Modo Oscuro
      const btnTema = document.getElementById('btn-tema');
      btnTema.addEventListener('click', () => {
        document.body.classList.toggle('tema-oscuro');
        const esOscuro = document.body.classList.contains('tema-oscuro');
        btnTema.textContent = esOscuro ? '☀️ Claro' : '🌙 Oscuro';
      });
    </script>
  </body>
</html>